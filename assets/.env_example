# Template for assets/.env, which is untracked. Copy this to that name and fill
# in the values. pubspec.yaml lists assets/.env, so the file has to exist or the
# build fails; this template is not listed and is not bundled.
#
# Named with an underscore, not .env.example: the repository's Claude Code
# settings deny Edit(**/.env.*), so a dotted name could not be maintained here.
#
# Everything here ships inside the release bundle. Verified 2026-09-05 by
# unzipping an AAB and finding assets/.env intact. Read the App Check note
# below before adding anything whose leak would matter.

# AdMob banner. Real ids, used in release builds. Debug builds use Google's
# INLINE ADAPTIVE demo units, which differ from the fixed-size ones:
#   Android  ca-app-pub-3940256099942544/9214589741
#   iOS      ca-app-pub-3940256099942544/2435281174
IOS_BANNER_UNIT_ID=
ANDROID_BANNER_UNIT_ID=

# App Check debug secrets, registered under Firebase Console -> App Check ->
# each app -> Manage debug tokens. Android and iOS are separate App Check apps,
# so the two values differ. Leave one empty and the SDK generates a token per
# install and logs it, which means registering a new token on every device.
#
# A registered debug token defeats App Check from anywhere, without the app.
# Because this file ships in the release bundle, a token left here is readable
# by anyone who downloads the app. Register a token only while developing on a
# device, and delete it from the Console when that device is done.
APPCHECK_ANDROID_DEBUG_TOKEN=
APPCHECK_IOS_DEBUG_TOKEN=
