rules_version = '2';

// Sign-in is email and password (lib/login_page.dart, lib/auth_manager.dart), so the uid identifies a person and owner binding is the whole protection.
// App Check enforcement is set in the Firebase console, and these rules do not depend on it.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if isOwner(uid);

      // The app never deletes its document, so delete is closed instead of sharing the write condition.
      allow create, update: if isOwner(uid) && isReasonableSize();
      allow delete: if false;

      // The app has no subcollection today, and scoping one to the owner now keeps a future one from hitting the deny below.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // The app only touches users/{uid} (lib/firebase_manager.dart, lib/homepage.dart).
    // Rules do not cascade, so this explicit deny makes a later broad match remove it on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isOwner(uid) {
  return request.auth != null && request.auth.uid == uid;
}

// 64 keys is far above the app's handful of JSON lists, so it stops stray field sets but not large strings, since size() counts keys and 1 MiB is the real ceiling.
// Field names are not allow-listed because setDataFireStore takes the key as a parameter (lib/firebase_manager.dart), so a new key would break the app.
function isReasonableSize() {
  return request.resource.data.size() <= 64;
}
